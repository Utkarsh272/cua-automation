# Copy to .env and fill in. Never commit .env.

# --- Discovery model (discovery only; replay never calls a model) ------------------------------
# Pick a provider with `cua discover --provider <name>`. Only that provider's key is needed.
# Free tiers: groq, gemini, openrouter, cerebras. Local and free: ollama. Paid: anthropic.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
# Optional per-provider model overrides (defaults live in src/cua/llm/providers.py):
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=<a model id ending in :free>
# OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Service account the automation uses to sign on to CU Core ---------------------------------
# These are the synthetic defaults baked into the local target app.
CU_CORE_USERNAME=svc_automation
CU_CORE_PASSWORD=Tr0ub4dor&3-synthetic

# --- Target app instances (one codebase, two tenants) -----------------------------------------
CU_CORE_TENANT_A_URL=http://localhost:8080
CU_CORE_TENANT_B_URL=http://localhost:8081

# --- Signs single-use confirmation tokens for irreversible steps ------------------------------
CUA_CONFIRMATION_SECRET=change-me-to-a-long-random-string
