# Copy to .env and fill in. Never commit .env.

# LLM used for discovery only. Replay never calls a model.
ANTHROPIC_API_KEY=
DISCOVERY_MODEL=claude-sonnet-5-5
# Optional, for cheap development iterations of the discovery loop.
GROQ_API_KEY=

# Service account the automation uses to log into CU Core.
# These are the synthetic defaults baked into the local target app.
CU_CORE_USERNAME=svc_automation
CU_CORE_PASSWORD=Tr0ub4dor&3-synthetic

# Target app instances (one codebase, two tenants).
CU_CORE_TENANT_A_URL=http://localhost:8080
CU_CORE_TENANT_B_URL=http://localhost:8081

# Signs single-use confirmation tokens for irreversible steps.
CUA_CONFIRMATION_SECRET=change-me-to-a-long-random-string
